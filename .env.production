# ── SECRETS — leave BLANK here; set in Vercel (Production). ──
# (Left empty on purpose so they never land in git. The deployed app reads
#  these from Vercel's env, which is why production already works.)
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_FALLBACK_MODEL=llama-3.3-70b-versatile
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_API_KEY=

# Anti-hallucination: production hides ribbon buttons whose handler is a
# `ribbonStub('Foo')`. Visible buttons must do something real. Unset/false in dev.
NEXT_PUBLIC_HIDE_RIBBON_STUBS=true

# ── Google sign-in ──
# There is NO Google env var in this project. Google OAuth is configured in the
# Supabase Dashboard → Authentication → Providers → Google (client ID + secret
# are entered THERE, plus the redirect URL). Nothing to add to this file.
